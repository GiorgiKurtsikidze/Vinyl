VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
# Optional: use if you provision custom auth tokens for field reps
VITE_FIREBASE_CUSTOM_TOKEN=

# Use to group deals per environment (preview vs production)
VITE_APP_SCOPE_ID=affiliate-workflow
# Customize where deals live in Firestore. {APP_ID} expands to VITE_APP_SCOPE_ID
VITE_FIRESTORE_COLLECTION_PATH=artifacts/{APP_ID}/public/data/deals

# AI provider settings (defaults target the OpenAI Chat Completions API)
VITE_OPENAI_API_KEY=sk-your-key
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
